# Нормализуем переводы строк: в репозитории всегда LF.
* text=auto eol=lf

# Явно помечаем текстовые файлы
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf

# Бинарные файлы — без преобразований
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.apk   binary
*.jar   binary
*.keystore binary
*.jks   binary

# Скрипты Gradle должны сохранять LF, иначе падают на Linux/macOS/CI
gradlew text eol=lf
*.bat   text eol=crlf

# Не показывать в статистике GitHub
package-lock.json linguist-generated=true
