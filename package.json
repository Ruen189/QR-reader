{
  "name": "qr-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QR-сканер на React + Vite, распознаёт коды с камеры и из изображений",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build --mode capacitor",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build:android && cap sync android",
    "android:copy": "npm run build:android && cap copy android",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "html5-qrcode": "^2.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.2"
  }
}
